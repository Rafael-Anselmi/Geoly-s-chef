<script id="app">
const $=s=>document.querySelector(s);
const SLOTS=[['breakfast','Breakfast','🌅'],['lunch','Lunch','🥪'],['dinner','Dinner','🍽️'],['snack','Snacks','🍎']];
const SLOTNAME=Object.fromEntries(SLOTS.map(s=>[s[0],s[1]]));
const CUIS={Classics:['Aussie classics','🥧','var(--t-sand)'],Italian:['Italian','🍝','var(--t-tomato)'],Asian:['Asian','🥢','var(--t-olive)'],Mexican:['Mexican','🌮','var(--t-mustard)'],Indian:['Indian','🍛','var(--t-saffron)'],Mediterranean:['Mediterranean','🫒','var(--t-sea)']};
const MOODS=[['quick','⚡ Quick',x=>x.time<=30],['protein','💪 High protein',x=>x.n.p>=40],['comfort','🍲 Comfort',x=>COMFORT.has(x.id)],['budget','💰 Budget',x=>x.per<=2.5],['kid','🧒 Kid-friendly',x=>x.kid],['freezer','❄️ Freezer-friendly',x=>x.flags.includes('f')]];
const AISLE_E={FV:'🥕',MS:'🥩',DE:'🧀',BK:'🍞',PA:'🥫',FR:'🧊',HS:'🧂',OT:'🛍️'};
const STORES=[['Woolworths','🟢'],['Coles','🔴'],['ALDI','🔵'],['IGA','🟠']];
const KEY='geolys_chef_v2';

/* ---------- state ---------- */
let S={onboarded:false,name:'',adults:2,kids:2,allergies:[],slots:{breakfast:false,lunch:false,dinner:true,snack:false},budget:180,store:'Woolworths',
  plan:{},ticked:{},custom:[],staples:true,favs:[],history:[],f:{type:'dinner',q:'',moods:[],cuisine:'',sort:'foryou'},savedTab:'favs'};
try{const v=JSON.parse(localStorage.getItem(KEY)||'null');if(v)S=Object.assign(S,v,{f:Object.assign(S.f,v.f||{})});}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
const people=()=>Math.max(1,S.adults+S.kids);
let pick=null,view='home';

/* ---------- recipe maths ---------- */
const byId=Object.fromEntries(R.map(x=>[x.id,x]));
const cuisOf={};Object.entries(CUISINE_OF).forEach(([c,s])=>s.split(' ').forEach(id=>cuisOf[id]=c));
const algOf={};Object.entries(ALG).forEach(([a,[, ,s]])=>s.split(' ').forEach(k=>(algOf[k]=algOf[k]||[]).push(a)));
R.forEach(x=>{
  x.total=x.ing.reduce((s,[k,q])=>s+q/I[k][3]*I[k][4],0);x.per=x.total/x.serves;
  x.kid=x.flags.includes('k');x.batch=x.flags.includes('b');x.cuisine=cuisOf[x.id]||'Classics';
  const n=[0,0,0,0];x.ing.forEach(([k,q])=>{const v=N[k],m=I[k][2]==='ea'?q:q/100;if(v)v.forEach((a,i)=>n[i]+=a*m);});
  x.n={kcal:n[0]/x.serves,p:n[1]/x.serves,c:n[2]/x.serves,f:n[3]/x.serves};
  x.alg=[...new Set(x.ing.flatMap(([k])=>algOf[k]||[]))];
  x.search=(x.name+' '+x.ing.map(([k])=>I[k][0]).join(' ')+' '+CUIS[x.cuisine][0]).toLowerCase();
});
const allowed=x=>!x.alg.some(a=>S.allergies.includes(a));
const moodTag=x=>{for(const [k,l,fn] of [MOODS[2],MOODS[0],MOODS[1],MOODS[3]])if(fn(x))return `<span class="tag ${k}">${l.split(' ').slice(1).join(' ')}</span>`;return '';};
const money=n=>'$'+n.toFixed(2);
const kcal=n=>Math.round(n/10)*10;
const tl=m=>m>=120?(m/60).toFixed(m%60?1:0)+' hr':m+' min';
function frac(q){q=Math.round(q*4)/4;const w=Math.floor(q),f={0.25:'¼',0.5:'½',0.75:'¾'}[q-w]||'';return w===0&&f?f:(w+f)||'0';}
const nice=q=>q<20?Math.round(q):q<100?Math.round(q/5)*5:Math.round(q/10)*10;
function fq(k,q){const u=I[k][2],lab=I[k][5];
  if(u==='g')return q>=1000?(+(q/1000).toFixed(2))+' kg':nice(q)+' g';
  if(u==='ml')return q>=1000?(+(q/1000).toFixed(2))+' L':nice(q)+' ml';
  return frac(q)+(lab?' '+lab:'');}
function fpack(k){const [, ,u,p, ,lab]=I[k];if(u==='g')return p>=1000?(p/1000)+' kg':p+' g';if(u==='ml')return p>=1000?(p/1000)+' L':p+' ml';return p===1?'each':p+(lab?' '+lab:'')+' pack';}
const tileBg=x=>CUIS[x.cuisine][2];

/* ---------- dates ---------- */
const now=new Date();const mon=new Date(now);mon.setHours(0,0,0,0);mon.setDate(mon.getDate()-((mon.getDay()+6)%7));
const dayDate=i=>{const d=new Date(mon);d.setDate(d.getDate()+i);return d;};
const DN=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const fmtD=d=>d.toLocaleDateString('en-AU',{day:'numeric',month:'short'});
const todayIdx=(now.getDay()+6)%7;

/* ---------- plan helpers ---------- */
const entries=()=>Object.entries(S.plan).filter(([k,v])=>v&&byId[v.id]&&S.slots[k.split('|')[1]]);
const sc=e=>{const x=byId[e.id];return x.batch?1:e.serves/x.serves;};
function buildList(){
  const tot={},used={};
  entries().forEach(([,e])=>{const x=byId[e.id],s=sc(e);x.ing.forEach(([k,q])=>{tot[k]=(tot[k]||0)+q*s;(used[k]=used[k]||new Set()).add(x.name);});});
  return Object.entries(tot).map(([k,q])=>{const [name,aisle,,pack,price,,staple]=I[k];const packs=Math.max(1,Math.ceil(q/pack-1e-6));
    return {k,name,aisle,q,packs,cost:packs*price,staple:!!staple,used:[...used[k]]};});
}
const buyList=()=>buildList().filter(i=>!(i.staple&&S.staples));
const shopTotal=()=>buyList().reduce((s,i)=>s+i.cost,0);
function shopCounts(){const b=buyList(),c=S.custom;const total=b.length+c.length;const done=b.filter(i=>S.ticked[i.k]).length+c.filter(i=>i.done).length;return {total,done};}
function updatePill(){const {total,done}=shopCounts(),p=$('#shopPill');p.hidden=!(total-done);p.textContent=total-done;}
function candidates(type,exclude){return R.filter(x=>x.type===type&&allowed(x)&&!exclude.has(x.id));}
function fillWeek(){
  const used=new Set(entries().map(([,e])=>e.id)),filled=[];
  DN.forEach((_,i)=>SLOTS.forEach(([k])=>{const key=i+'|'+k;if(!S.slots[k]||S.plan[key])return;
    let c=candidates(k,used);if(!c.length)c=R.filter(x=>x.type===k&&allowed(x));if(!c.length)return;
    if(S.f.moods.length){const m=c.filter(x=>S.f.moods.every(id=>MOODS.find(z=>z[0]===id)[2](x)));if(m.length)c=m;}
    const x=c[Math.floor(Math.random()*c.length)];S.plan[key]={id:x.id,serves:x.batch?x.serves:people()};used.add(x.id);filled.push(key);}));
  // keep within budget: swap the priciest auto-picked meals for cheaper ones
  for(let t=0;t<25&&shopTotal()>S.budget;t++){
    const cand=filled.map(k=>[k,byId[S.plan[k].id]]).sort((a,b)=>b[1].per-a[1].per);let changed=false;
    for(const [k,x] of cand){const cheaper=candidates(x.type,new Set(entries().map(([,e])=>e.id))).filter(y=>y.per<x.per);
      if(cheaper.length){const y=cheaper.sort((a,b)=>a.per-b.per)[Math.floor(Math.random()*Math.min(3,cheaper.length))];S.plan[k]={id:y.id,serves:y.batch?y.serves:people()};changed=true;break;}}
    if(!changed)break;}
  save();return filled.length;
}
function swap(key){const e=S.plan[key],x=byId[e.id];const c=candidates(x.type,new Set(entries().map(([,v])=>v.id)));
  if(!c.length){toast('No other recipes fit right now');return;}
  const y=c[Math.floor(Math.random()*c.length)];S.plan[key]={id:y.id,serves:y.batch?y.serves:e.serves};save();render();toast(`Swapped for ${y.name}`);}

/* ---------- ui helpers ---------- */
