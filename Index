function addFlow(id,serves){
  const x=byId[id];serves=x.batch?x.serves:(serves||people());
  if(pick){S.plan[pick.d+'|'+pick.slot]={id,serves};const d=pick.d;pick=null;save();toast(`${x.name} → ${DN[d]}`);show('home');return;}
  openSheet(`<div style="display:flex;align-items:center;gap:12px"><span class="thumb" style="background:${tileBg(x)}">${x.emoji}</span><div><div class="eyebrow">${SLOTNAME[x.type]} · ${serves} serves</div><h2>${x.name}</h2></div></div>
    <h3 style="margin-top:16px">Which night?</h3>
    <div class="daypick">${DN.map((d,i)=>{const cur=S.plan[i+'|'+x.type],c=cur&&byId[cur.id];return `<button data-d="${i}"><b>${d} <span style="color:var(--muted);font-weight:500">${fmtD(dayDate(i))}</span></b><small>${c?'Replace '+c.name:'Free'}</small></button>`;}).join('')}</div>`);
  document.querySelectorAll('#sheet [data-d]').forEach(b=>b.onclick=()=>{const d=+b.dataset.d;S.plan[d+'|'+x.type]={id,serves};let m=`Added to ${DN[d]}`;
    if(!S.slots[x.type]){S.slots[x.type]=true;m+=` · ${SLOTNAME[x.type]} switched on`;}save();closeSheet();render();toast(m);});
}

/* ---------- ONBOARDING ---------- */
let ob={step:0,edit:false,d:null};
const OB_STEPS=6;
function openOnb(step,edit){ob={step:step||0,edit:!!edit,d:JSON.parse(JSON.stringify({name:S.name,adults:S.adults,kids:S.kids,allergies:S.allergies,noAlg:S.onboarded&&!S.allergies.length,slots:S.slots,budget:S.budget,store:S.store}))};$('#onb').classList.add('on');document.body.style.overflow='hidden';drawOnb();}
function closeOnb(){$('#onb').classList.remove('on');document.body.style.overflow='';}
function drawOnb(){
  const d=ob.d,st=ob.step;let body='',next='Next',canNext=true;
  if(st===0){body=`<div class="welcome"><div class="plate">🍲</div><h1>Your week, sorted<span class="q">.</span></h1><p class="lede">A few quick questions and we’ll plan a week of meals around your family and your budget.</p>
      <input class="field" id="oName" placeholder="Your first name (optional)" value="${esc(d.name)}" autocomplete="given-name"></div>`;next='Let’s go';}
  if(st===1){body=`<h1>Who’s eating<span class="q">?</span></h1><p class="lede">We’ll size every recipe and the shopping list to fit.</p>
      ${[['adults','Adults','18+'],['kids','Kids','Under 18']].map(([k,l,s])=>`<div class="card counter"><div class="lbl"><b>${l}</b><small>${s}</small></div><div class="stepper" style="flex:none"><button data-dec="${k}" aria-label="Fewer ${l}">−</button><b style="min-width:30px">${d[k]}</b><button class="plus" data-inc="${k}" aria-label="More ${l}">+</button></div></div>`).join('')}`;
      canNext=d.adults+d.kids>0;}
  if(st===2){body=`<h1>Any allergies<span class="q">?</span></h1><p class="lede">Tap anything your household can’t eat and we’ll keep it out of every plan.</p>
      <div class="tiles">${Object.entries(ALG).map(([k,[l,e]])=>`<button class="tilebtn ${d.allergies.includes(k)?'on':''}" data-alg="${k}"><span class="e">${e}</span>${l}</button>`).join('')}</div>
      <button class="noneopt ${d.noAlg&&!d.allergies.length?'on':''}" id="noAlg"><span style="font-size:22px">👍</span><span><b>No allergies</b><br><small style="color:var(--muted)">Nothing to keep out</small></span><span class="r"></span></button>
      <p class="fine">Recipes are filtered by their main ingredients. Packaged foods can contain hidden allergens, so always check labels.</p>`;
      canNext=d.allergies.length||d.noAlg;}
  if(st===3){body=`<h1>Which meals<span class="q">?</span></h1><p class="lede">Choose what you’d like planned each day. You can change this any time.</p>
      <div class="tiles two">${SLOTS.map(([k,l,e])=>`<button class="tilebtn ${d.slots[k]?'on':''}" data-slot="${k}"><span class="e" style="font-size:24px">${e}</span>${l}</button>`).join('')}</div>`;
      canNext=Object.values(d.slots).some(Boolean);}
  if(st===4){body=`<h1>Weekly budget<span class="q">?</span></h1><p class="lede">For the meals we plan. We’ll keep the shopping list under it where we can.</p>
      <div class="card money"><span>$</span><input id="oBudget" type="number" inputmode="numeric" min="0" step="5" value="${d.budget}" aria-label="Weekly budget in dollars"></div>
      <div class="quick">${[100,150,200,250,300].map(v=>`<button class="pillbtn ${+d.budget===v?'primary':''}" data-bud="${v}">$${v}</button>`).join('')}</div>`;canNext=+d.budget>0;}
  if(st===5){body=`<h1>Where do you shop<span class="q">?</span></h1><p class="lede">We’ll build your list for this store. Live prices are coming soon; for now, prices are estimates.</p>
      <div class="stores">${STORES.map(([s,e])=>`<button class="tilebtn ${d.store===s?'on':''}" data-store="${s}" style="flex-direction:row;justify-content:flex-start;padding:16px;font-size:15px"><span>${e}</span>${s}</button>`).join('')}</div>`;
      next=ob.edit&&S.onboarded?'Save':'Plan my week';}
  $('#onb').innerHTML=`<div class="onb"><div class="prog">${st>0||ob.edit?`<button class="back" id="oBack" aria-label="Back">${st>0?'‹':'✕'}</button>`:''}${Array.from({length:OB_STEPS},(_,i)=>`<i class="${i<=st?'on':''}"></i>`).join('')}</div>${body}</div>
    <div class="onbfoot"><div class="in"><button class="btn block" id="oNext" ${canNext?'':'disabled style="opacity:.45"'}>${next}</button></div></div>`;
  const o=$('#onb');
  $('#oBack')&&($('#oBack').onclick=()=>{if(st>0){ob.step--;drawOnb();}else closeOnb();});
  $('#oName')&&($('#oName').oninput=e=>d.name=e.target.value.slice(0,30));
  o.querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>{d[b.dataset.inc]=Math.min(12,d[b.dataset.inc]+1);drawOnb();});
  o.querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>{d[b.dataset.dec]=Math.max(0,d[b.dataset.dec]-1);drawOnb();});
  o.querySelectorAll('[data-alg]').forEach(b=>b.onclick=()=>{const k=b.dataset.alg;d.allergies=d.allergies.includes(k)?d.allergies.filter(a=>a!==k):[...d.allergies,k];d.noAlg=false;drawOnb();});
  $('#noAlg')&&($('#noAlg').onclick=()=>{d.allergies=[];d.noAlg=true;drawOnb();});
  o.querySelectorAll('[data-slot]').forEach(b=>b.onclick=()=>{d.slots[b.dataset.slot]=!d.slots[b.dataset.slot];drawOnb();});
  $('#oBudget')&&($('#oBudget').oninput=e=>{d.budget=Math.max(0,+e.target.value||0);$('#oNext').disabled=!(d.budget>0);$('#oNext').style.opacity=d.budget>0?'':'.45';o.querySelectorAll('[data-bud]').forEach(x=>x.classList.toggle('primary',+x.dataset.bud===d.budget));});
  o.querySelectorAll('[data-bud]').forEach(b=>b.onclick=()=>{d.budget=+b.dataset.bud;drawOnb();});
  o.querySelectorAll('[data-store]').forEach(b=>b.onclick=()=>{d.store=b.dataset.store;drawOnb();});
  $('#oNext').onclick=()=>{if(!canNext)return;if(st<OB_STEPS-1){ob.step++;drawOnb();return;}finishOnb();};
}
function finishOnb(){
  const d=ob.d,first=!S.onboarded,oldPeople=people();
  Object.assign(S,{name:d.name.trim(),adults:d.adults,kids:d.kids,allergies:d.allergies,slots:d.slots,budget:d.budget,store:d.store,onboarded:true});
  // keep the plan consistent with new settings
  Object.entries(S.plan).forEach(([k,e])=>{const x=e&&byId[e.id];if(!x||!allowed(x))delete S.plan[k];else if(!x.batch&&e.serves===oldPeople)e.serves=people();});
  save();closeOnb();
  if(first||!entries().length){const n=fillWeek();show('home');toast(n?`Here’s your week: ${n} meals${shopTotal()<=S.budget?', within budget':''}`:'All set');}
  else{show(view);toast('Settings saved');}
}
$('#settingsBtn').onclick=()=>openOnb(1,true);

function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

render();
if(!S.onboarded)openOnb(0,false);
</script>
</body>
