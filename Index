<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Geoly’s Chef</title>
<meta name="description" content="Plan your family's meals for the week, on budget, with one combined grocery list.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FBF4EA;--surface:#FFFCF7;--surface-2:#F4E9DA;--ink:#2B211C;--muted:#7B6B60;--line:#E6D7C4;
  --primary:#C2553A;--primary-ink:#FFFFFF;--primary-soft:#F7DED3;--primary-deep:#9E4029;
  --olive:#5E6B2E;--olive-soft:#E7EBD3;--mustard-soft:#F8EAC7;--plum:#8A4F7D;--plum-soft:#F0E0EA;--warn:#B23A1E;
  --t-sand:#F3E3CB;--t-tomato:#F6D5C8;--t-olive:#E2E8CC;--t-mustard:#F7E6BE;--t-saffron:#F9DDB5;--t-sea:#D6E7E2;
  --p:#C2553A;--c:#E2A93B;--f:#7C8B3F;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1A1411;--surface:#241C18;--surface-2:#2E2420;--ink:#F3E9DF;--muted:#B3A398;--line:#3A2E28;
    --primary:#E07A5C;--primary-ink:#1A1411;--primary-soft:#3D241C;--primary-deep:#F0A088;
    --olive:#B5C27A;--olive-soft:#2B2F1C;--mustard-soft:#3A3120;--plum:#D9A0C9;--plum-soft:#33242E;--warn:#F08A6E;
    --t-sand:#3A2F24;--t-tomato:#3E2620;--t-olive:#2C3121;--t-mustard:#3A3120;--t-saffron:#3D2E1C;--t-sea:#1F3330;
    --p:#E07A5C;--c:#E8B95A;--f:#A8B86A;
  }
}
:root[data-theme="dark"]{
  --bg:#1A1411;--surface:#241C18;--surface-2:#2E2420;--ink:#F3E9DF;--muted:#B3A398;--line:#3A2E28;
  --primary:#E07A5C;--primary-ink:#1A1411;--primary-soft:#3D241C;--primary-deep:#F0A088;
  --olive:#B5C27A;--olive-soft:#2B2F1C;--mustard-soft:#3A3120;--plum:#D9A0C9;--plum-soft:#33242E;--warn:#F08A6E;
  --t-sand:#3A2F24;--t-tomato:#3E2620;--t-olive:#2C3121;--t-mustard:#3A3120;--t-saffron:#3D2E1C;--t-sea:#1F3330;
  --p:#E07A5C;--c:#E8B95A;--f:#A8B86A;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:15px/1.45 Figtree,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;padding-bottom:90px}
h1,h2,h3{font-family:"Bricolage Grotesque",Figtree,sans-serif;margin:0;letter-spacing:-.02em;line-height:1.1}
h1{font-size:30px;font-weight:800}
h2{font-size:21px;font-weight:800}
h3{font-size:16px;font-weight:700;letter-spacing:-.01em}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
.wrap{max-width:720px;margin:0 auto;padding:0 16px}
.top{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(10px)}
.top .wrap{display:flex;align-items:center;height:58px;gap:10px}
.logo{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:22px;letter-spacing:-.03em;display:flex;align-items:center;gap:8px;white-space:nowrap}
.logo .hat{width:32px;height:32px;border-radius:10px;background:var(--primary);color:var(--primary-ink);display:grid;place-items:center;font-size:17px}
.logo b{color:var(--primary);font-weight:800}
.iconbtn{margin-left:auto;width:40px;height:40px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);display:grid;place-items:center;font-size:17px;flex:none}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
.lede{color:var(--muted);margin:6px 0 0}
section.view{display:none;padding-top:8px}
section.view.on{display:block}
.head{margin:6px 0 16px}
.head h1 .dot{color:var(--primary)}
.card{background:var(--surface);border:1.5px solid var(--line);border-radius:20px;box-shadow:0 2px 0 var(--line)}
/* home */
.dash{display:grid;grid-template-columns:1.15fr 1fr;gap:10px;margin-bottom:22px}
.bud{background:var(--primary);color:var(--primary-ink);border-radius:20px;padding:14px;position:relative;border:none;text-align:left}
.bud .eyebrow{color:color-mix(in srgb,var(--primary-ink) 75%,transparent)}
.bud .big{font-family:"Bricolage Grotesque",sans-serif;font-size:30px;font-weight:800;margin:4px 0 8px;letter-spacing:-.03em}
.bud small{opacity:.85;font-size:12px}
.budtop{display:flex;justify-content:space-between;align-items:center;gap:6px}
.badge-left{font-size:11px;white-space:nowrap;font-weight:700;padding:3px 8px;border-radius:999px;background:var(--primary-ink);color:var(--primary)}
.badge-left.over{background:#FFE3D8;color:var(--warn)}
.bar{height:7px;border-radius:99px;background:color-mix(in srgb,currentColor 22%,transparent);overflow:hidden;margin-bottom:6px}
.bar i{display:block;height:100%;border-radius:99px;background:currentColor}
.bud .bar i{background:var(--primary-ink)}
.shopcard{background:var(--olive-soft);color:var(--olive);border-radius:20px;padding:14px;border:none;text-align:left}
.shopcard .t{display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:16px;margin:4px 0 10px;color:var(--ink)}
.shopcard small{color:var(--muted);font-size:12px}
.sectitle{display:flex;align-items:center;gap:8px;margin:0 0 10px}
.sectitle h2{flex:1}
.pillbtn{border:1.5px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 12px;font-size:13px;font-weight:600;white-space:nowrap}
.pillbtn.primary{background:var(--primary);border-color:var(--primary);color:var(--primary-ink)}
.dayhead{display:flex;align-items:baseline;gap:8px;margin:18px 2px 8px}
.dayhead b{font-family:"Bricolage Grotesque",sans-serif;font-size:17px;font-weight:800}
.dayhead span{color:var(--muted);font-size:13px}
.dayhead.today b{color:var(--primary)}
.mrow{display:flex;gap:12px;align-items:center;padding:10px;margin-bottom:8px}
.thumb{flex:none;width:64px;height:64px;border-radius:16px;display:grid;place-items:center;font-size:34px;border:none}
.mbody{flex:1;min-width:0;background:none;border:none;text-align:left;padding:0}
.mbody b{display:block;font-weight:700;font-size:15px;line-height:1.25;margin:2px 0 4px}
.meta{color:var(--muted);font-size:13px;display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center}
.tag{font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--surface-2);color:var(--muted)}
.tag.quick{background:var(--mustard-soft);color:#8A5A0B}
.tag.protein{background:var(--primary-soft);color:var(--primary-deep)}
.tag.comfort{background:var(--plum-soft);color:var(--plum)}
.tag.budget{background:var(--olive-soft);color:var(--olive)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .tag.quick{color:var(--c)}}
:root[data-theme="dark"] .tag.quick{color:var(--c)}
.mact{display:flex;flex-direction:column;gap:6px}
.round{width:34px;height:34px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);display:grid;place-items:center;font-size:15px;color:var(--muted)}
.round.swap{background:var(--primary-soft);border-color:transparent;color:var(--primary-deep)}
.addslot{display:flex;align-items:center;gap:12px;width:100%;padding:12px;margin-bottom:8px;border:1.5px dashed var(--line);border-radius:20px;background:transparent;color:var(--muted);text-align:left}
.addslot .plus{width:40px;height:40px;border-radius:12px;background:var(--surface-2);display:grid;place-items:center;font-size:20px;color:var(--primary)}
/* recipes */
.search{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);background:var(--surface);border-radius:999px;padding:0 16px;margin-bottom:14px}
.search input{border:none;background:none;outline:none;flex:1;padding:12px 0;min-width:0}
.seg{display:flex;background:var(--surface-2);border-radius:999px;padding:4px;gap:2px;margin-bottom:14px}
.seg button{flex:1;border:none;background:none;border-radius:999px;padding:8px 4px;font-size:13px;font-weight:600;color:var(--muted)}
.seg button.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.scroller{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;margin:0 -16px 12px;padding:2px 16px}
.scroller::-webkit-scrollbar{display:none}
.cuis{flex:none;display:flex;flex-direction:column;align-items:center;gap:5px;background:none;border:none;padding:0;font-size:12px;font-weight:600;color:var(--muted);width:68px}
.cuis .c{width:58px;height:58px;border-radius:999px;display:grid;place-items:center;font-size:28px;border:2px solid transparent}
.cuis.on{color:var(--ink)}
.cuis.on .c{border-color:var(--primary)}
.mood{flex:none;border:1.5px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 13px;font-size:13px;font-weight:600;white-space:nowrap}
.mood.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.sorts{display:flex;gap:16px;align-items:center;margin:4px 2px 12px;font-size:13px}
.sorts button{border:none;background:none;padding:4px 0;color:var(--muted);font-weight:600}
.sorts button.on{color:var(--primary);box-shadow:inset 0 -2px 0 var(--primary)}
.sorts .count{margin-left:auto;color:var(--muted)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(min-width:620px){.grid{grid-template-columns:repeat(3,1fr)}}
.rcard{overflow:hidden;display:flex;flex-direction:column;position:relative}
.rcard .tile{height:104px;display:grid;place-items:center;font-size:52px;border:none;width:100%}
.heart{position:absolute;top:8px;right:8px;width:34px;height:34px;border-radius:999px;border:none;background:var(--surface);display:grid;place-items:center;font-size:15px;box-shadow:0 1px 3px rgba(0,0,0,.1)}
.heart.on{color:var(--primary)}
.rcard .rb{padding:10px 12px 12px;display:flex;flex-direction:column;gap:6px;flex:1}
.rcard h3{font-size:15px;background:none;border:none;padding:0;text-align:left}
.rcard .foot{display:flex;align-items:center;justify-content:space-between;margin-top:auto}
.price{font-weight:800;font-family:"Bricolage Grotesque",sans-serif;font-size:16px}
.price small{font-family:Figtree,sans-serif;font-weight:500;color:var(--muted);font-size:11px}
.addbtn{width:34px;height:34px;border-radius:999px;border:none;background:var(--primary);color:var(--primary-ink);font-size:20px;line-height:1;display:grid;place-items:center}
.note{color:var(--muted);font-size:12px;margin:10px 2px}
.alertnote{background:var(--mustard-soft);border-radius:14px;padding:9px 12px;font-size:13px;margin-bottom:12px}
.banner{background:var(--primary-soft);color:var(--primary-deep);border-radius:16px;padding:10px 12px;font-size:14px;display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px}
.empty{text-align:center;color:var(--muted);padding:36px 16px}
.empty .big{font-size:46px;margin-bottom:6px}
/* list rows (saved) */
.lrow{display:flex;gap:12px;align-items:center;padding:10px;margin-bottom:8px}
.lrow .btn{flex:none}
.btn{border:none;border-radius:999px;padding:10px 16px;font-weight:700;white-space:nowrap;background:var(--primary);color:var(--primary-ink)}
.btn.soft{background:var(--primary-soft);color:var(--primary-deep)}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink)}
.btn.small{padding:7px 12px;font-size:13px}
.btn.block{width:100%;padding:14px}
/* shop */
.bag{background:var(--olive-soft);border-radius:22px;padding:16px;margin-bottom:12px;color:var(--olive)}
.bag .storechip{display:inline-block;background:var(--surface);color:var(--ink);border-radius:999px;font-size:12px;font-weight:700;padding:3px 10px;margin-bottom:8px}
.bag .num{font-family:"Bricolage Grotesque",sans-serif;font-size:34px;font-weight:800;color:var(--ink);letter-spacing:-.03em}
.bag .num small{font-size:16px;color:var(--muted);font-weight:700}
.bag .sub{color:var(--ink);font-size:13px;margin-top:4px}
.bag .sub .neg{color:var(--warn);font-weight:700}
.tools{display:flex;gap:8px;margin-bottom:10px}
.addrow{flex:1;min-width:0;display:flex;border:1.5px dashed var(--line);border-radius:999px;padding:0 6px 0 14px;align-items:center;background:var(--surface)}
.addrow input{flex:1;border:none;background:none;outline:none;padding:10px 0;min-width:0}
.addrow button{border:none;background:var(--primary);color:var(--primary-ink);border-radius:999px;width:30px;height:30px;font-size:18px}
.toggle{display:flex;align-items:center;gap:8px;font-size:14px;margin:4px 2px 14px}
.toggle input{width:18px;height:18px;accent-color:var(--primary)}
.aisle{padding:4px 14px;margin-bottom:12px}
.aisle h3{font-size:14px;padding:12px 0 6px;display:flex;align-items:center;gap:6px}
.item{display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line);cursor:pointer}
.item .ie{width:38px;height:38px;border-radius:12px;background:var(--surface-2);display:grid;place-items:center;font-size:19px;flex:none}
.item .nm{flex:1;min-width:0}
.item .nm b{font-weight:600}
.item .nm small{display:block;color:var(--muted);font-size:12px}
.item .q{text-align:right;font-size:13px;white-space:nowrap}
.item .q b{display:block;font-size:14px}
.chk{width:26px;height:26px;border-radius:999px;border:2px solid var(--line);flex:none;display:grid;place-items:center;font-size:13px;color:transparent}
.item.done .chk{background:var(--olive);border-color:var(--olive);color:var(--surface)}
.item.done .nm b{text-decoration:line-through;color:var(--muted)}
.item.done .ie{opacity:.5}
/* nav */
nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1.5px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}
nav.tabs .wrap{display:grid;grid-template-columns:repeat(4,1fr)}
nav.tabs button{border:none;background:none;padding:8px 0 10px;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11.5px;font-weight:600;color:var(--muted);position:relative}
nav.tabs .ic{font-size:20px;width:46px;height:28px;border-radius:999px;display:grid;place-items:center}
nav.tabs button.on{color:var(--primary)}
nav.tabs button.on .ic{background:var(--primary-soft)}
.pill{position:absolute;top:3px;left:calc(50% + 10px);background:var(--primary);color:var(--primary-ink);border-radius:999px;font-size:10px;padding:1px 6px;font-weight:700}
/* sheet */
.overlay{position:fixed;inset:0;background:rgba(20,12,8,.5);z-index:50;display:none;align-items:flex-end;justify-content:center}
.overlay.on{display:flex}
.sheet{background:var(--bg);width:100%;max-width:640px;max-height:92vh;overflow:auto;border-radius:26px 26px 0 0;padding:16px 16px 28px}
@media(min-width:700px){.overlay{align-items:center}.sheet{border-radius:26px}}
.hero{height:190px;border-radius:22px;display:grid;place-items:center;font-size:96px;position:relative;margin-bottom:14px}
.hero .round{position:absolute;top:12px;background:var(--surface);border:none;color:var(--ink);width:40px;height:40px;font-size:17px}
.hero .l{left:12px}.hero .r{right:12px}
.hero .r.on{color:var(--primary)}
.stats{padding:14px;margin:14px 0}
.stats .row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stats .row div{background:var(--surface-2);border-radius:14px;padding:8px 10px}
.stats .row b{display:block;font-family:"Bricolage Grotesque",sans-serif;font-size:20px;font-weight:800}
.stats .row span{color:var(--muted);font-size:12px}
.stats .row .pr{background:var(--primary-soft)}
.stats .row .pr b{color:var(--primary-deep)}
.macro{display:flex;height:10px;border-radius:99px;overflow:hidden;margin:12px 0 8px;gap:2px}
.macro i{display:block;height:100%}
.mleg{display:flex;justify-content:space-between;font-size:13px}
.mleg b{font-size:17px;font-family:"Bricolage Grotesque",sans-serif}
.mleg span{display:flex;align-items:center;gap:5px;color:var(--muted);font-size:12px}
.mleg span::before{content:"";width:8px;height:8px;border-radius:99px;background:var(--d)}
.servebox{display:flex;align-items:center;gap:10px;padding:10px;margin-bottom:14px}
.stepper{display:flex;align-items:center;gap:10px;flex:1}
.stepper button{width:36px;height:36px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);font-size:18px}
.stepper button.plus{background:var(--primary);color:var(--primary-ink);border-color:var(--primary)}
.stepper b{font-size:16px;min-width:88px;text-align:center}
.tabsx{display:flex;gap:6px;margin-bottom:-1.5px;position:relative;z-index:1}
.tabsx button{border:1.5px solid var(--line);border-bottom:none;background:var(--surface-2);border-radius:14px 14px 0 0;padding:9px 14px;font-weight:700;font-size:14px;color:var(--muted)}
.tabsx button.on{background:var(--surface);color:var(--ink)}
.tabsx button i{font-style:normal;font-size:11px;background:var(--primary-soft);color:var(--primary-deep);border-radius:999px;padding:1px 7px;margin-left:4px}
.tabbody{border-radius:0 18px 18px 18px;padding:6px 14px 12px}
.ing{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.ing:last-child{border-bottom:none}
.ing span:last-child{color:var(--muted);white-space:nowrap}
.steps{margin:0;padding:0;list-style:none;counter-reset:s}
.steps li{counter-increment:s;display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.steps li:last-child{border-bottom:none}
.steps li::before{content:counter(s);flex:none;width:26px;height:26px;border-radius:999px;background:var(--primary-soft);color:var(--primary-deep);font-weight:700;font-size:13px;display:grid;place-items:center}
.daypick{display:grid;gap:8px;margin-top:14px}
.daypick button{display:flex;justify-content:space-between;gap:8px;align-items:center;text-align:left;padding:12px 14px;border-radius:16px;border:1.5px solid var(--line);background:var(--surface)}
.daypick small{color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:62%}
.toast{position:fixed;left:50%;bottom:100px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px;font-size:14px;opacity:0;transition:.25s;z-index:80;pointer-events:none;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
/* onboarding */
#onb{position:fixed;inset:0;z-index:70;background:var(--bg);display:none;overflow:auto}
#onb.on{display:block}
.onb{max-width:520px;margin:0 auto;padding:18px 20px 120px;min-height:100%}
.prog{display:flex;gap:6px;align-items:center;margin-bottom:28px}
.prog i{flex:1;height:6px;border-radius:99px;background:var(--line)}
.prog i.on{background:var(--primary)}
.prog .back{width:38px;height:38px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);margin-right:6px;flex:none}
.onb h1{font-size:32px;margin-bottom:8px}
.onb h1 .q{color:var(--primary)}
.onb .lede{margin-bottom:22px}
.field{display:block;width:100%;padding:14px 16px;border-radius:16px;border:1.5px solid var(--line);background:var(--surface);font-size:16px}
.counter{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;margin-bottom:10px}
.counter .lbl b{display:block;font-size:16px}
.counter .lbl small{color:var(--muted)}
.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.tiles.two{grid-template-columns:1fr 1fr}
.tilebtn{border:1.5px solid var(--line);background:var(--surface);border-radius:18px;padding:12px 4px 10px;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:13px;font-weight:600;position:relative}
.tilebtn .e{font-size:30px}
.tilebtn.on{border-color:var(--primary);background:var(--primary-soft);color:var(--primary-deep)}
.tilebtn.on::after{content:"✕";position:absolute;top:6px;right:8px;font-size:11px}
.tiles.two .tilebtn{flex-direction:row;justify-content:flex-start;padding:14px;gap:12px;font-size:15px}
.tiles.two .tilebtn.on::after{content:"✓"}
.noneopt{display:flex;align-items:center;gap:12px;width:100%;margin-top:12px;padding:14px 16px;border-radius:18px;border:1.5px solid var(--line);background:var(--surface);text-align:left}
.noneopt.on{border-color:var(--olive);background:var(--olive-soft)}
