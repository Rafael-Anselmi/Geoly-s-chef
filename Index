.quick{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.onbfoot{position:fixed;left:0;right:0;bottom:0;padding:14px 20px calc(14px + env(safe-area-inset-bottom));background:linear-gradient(transparent,var(--bg) 30%)}
