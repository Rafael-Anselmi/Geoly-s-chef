/* ---------- RECIPES ---------- */
function filtered(){
  const f=S.f,q=f.q.trim().toLowerCase();
  let l=R.filter(x=>allowed(x)&&(pick?x.type===pick.slot:(f.type==='all'||x.type===f.type))&&(!q||x.search.includes(q))&&(!f.cuisine||x.cuisine===f.cuisine)&&f.moods.every(id=>MOODS.find(m=>m[0]===id)[2](x)));
  const so={foryou:(a,b)=>(isFav(b.id)-isFav(a.id))||(a.per-b.per),cheap:(a,b)=>a.per-b.per,quick:(a,b)=>a.time-b.time}[f.sort];
  return l.sort(so);
}
function renderRecipes(){
  const f=S.f,list=filtered(),hidden=R.filter(x=>!allowed(x)).length;
  const typeLabel=pick?SLOTNAME[pick.slot].toLowerCase():f.type==='all'?'cooking':f.type==='snack'?'for snacks':'for '+f.type;
  let h=`<div class="head"><div class="eyebrow">Recipes</div><h1>What’s ${typeLabel}<span class="dot">?</span></h1><p class="lede">Browse by cuisine, mood or ingredient.</p></div>`;
  if(pick)h+=`<div class="banner"><span>Choosing <b>${SLOTNAME[pick.slot].toLowerCase()}</b> for <b>${DN[pick.d]}</b></span><button class="btn small ghost" id="cancelPick">Cancel</button></div>`;
  h+=`<label class="search"><span>🔍</span><input id="q" type="search" placeholder="Search meals or ingredients" value="${esc(f.q)}" aria-label="Search"></label>`;
  if(!pick)h+=`<div class="seg">${[['breakfast','Breakfast'],['lunch','Lunch'],['dinner','Dinner'],['snack','Snacks'],['all','All']].map(([k,l])=>`<button data-type="${k}" class="${f.type===k?'on':''}">${l}</button>`).join('')}</div>`;
  h+=`<div class="scroller">${Object.entries(CUIS).map(([k,[l,e,c]])=>`<button class="cuis ${f.cuisine===k?'on':''}" data-cuis="${k}"><span class="c" style="background:${c}">${e}</span>${l}</button>`).join('')}</div>
  <div class="scroller">${MOODS.map(([k,l])=>`<button class="mood ${f.moods.includes(k)?'on':''}" data-mood="${k}">${l}</button>`).join('')}</div>`;
  if(hidden&&S.allergies.length)h+=`<div class="alertnote">Hiding ${hidden} recipes with ${S.allergies.map(a=>ALG[a][0].toLowerCase()).join(', ')} in their main ingredients. Packaged foods can contain hidden allergens, so always check labels.</div>`;
  h+=`<div class="sorts">${[['foryou','✦ For you'],['cheap','Cheapest'],['quick','Quickest']].map(([k,l])=>`<button data-sort="${k}" class="${f.sort===k?'on':''}">${l}</button>`).join('')}<span class="count">${list.length} recipes</span></div>`;
  h+=list.length?`<div class="grid">${list.map(card).join('')}</div>`:`<div class="empty"><div class="big">🔍</div>No recipes match. Try removing a mood or cuisine.</div>`;
  h+=`<p class="note">Prices per serve and calories are estimates.</p>`;
  const v=$('#v-recipes');v.innerHTML=h;bind(v);
  const qi=$('#q');qi.oninput=e=>{S.f.q=e.target.value;save();const p=qi.selectionStart;renderRecipes();const n=$('#q');n.focus();n.setSelectionRange(p,p);};
  if(pick)$('#cancelPick').onclick=()=>{pick=null;show('home');};
  v.querySelectorAll('[data-type]').forEach(b=>b.onclick=()=>{S.f.type=b.dataset.type;save();renderRecipes();});
  v.querySelectorAll('[data-cuis]').forEach(b=>b.onclick=()=>{S.f.cuisine=S.f.cuisine===b.dataset.cuis?'':b.dataset.cuis;save();renderRecipes();});
  v.querySelectorAll('[data-mood]').forEach(b=>b.onclick=()=>{const m=b.dataset.mood;S.f.moods=S.f.moods.includes(m)?S.f.moods.filter(x=>x!==m):[...S.f.moods,m];save();renderRecipes();});
  v.querySelectorAll('[data-sort]').forEach(b=>b.onclick=()=>{S.f.sort=b.dataset.sort;save();renderRecipes();});
