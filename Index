      <div class="macro"><i style="width:${n.p*4/tot*100}%;background:var(--p)"></i><i style="width:${n.c*4/tot*100}%;background:var(--c)"></i><i style="width:${n.f*9/tot*100}%;background:var(--f)"></i></div>
      <div class="mleg"><div><b>${Math.round(n.p)}g</b><span style="--d:var(--p)">Protein</span></div><div><b>${Math.round(n.c)}g</b><span style="--d:var(--c)">Carbs</span></div><div style="text-align:right"><b>${Math.round(n.f)}g</b><span style="--d:var(--f)">Fat</span></div></div>
