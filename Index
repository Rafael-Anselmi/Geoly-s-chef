async function shareList(useShare){
  const items=buyList().filter(i=>!S.ticked[i.k]),cust=S.custom.filter(c=>!c.done);
  if(!items.length&&!cust.length){toast('Nothing left on the list');return;}
  const groups={};items.forEach(i=>(groups[i.aisle]=groups[i.aisle]||[]).push(i));
  let text=`Geoly’s Chef grocery list (${S.store})\n`+Object.keys(AISLES).filter(a=>groups[a]).map(a=>`\n${AISLES[a].toUpperCase()}\n`+groups[a].map(i=>`☐ ${i.name} (${i.packs} × ${fpack(i.k)})`).join('\n')).join('\n');
  if(cust.length)text+=`\n\nOTHER\n`+cust.map(c=>'☐ '+c.name).join('\n');
  text+=`\n\nEstimated total: ${money(items.reduce((s,i)=>s+i.cost,0))}`;
  if(useShare&&navigator.share){try{await navigator.share({title:'Grocery list',text});return;}catch(e){if(e.name==='AbortError')return;}}
  try{await navigator.clipboard.writeText(text);toast('List copied');}catch(e){openSheet(`<h2>Copy your list</h2><textarea style="width:100%;height:50vh;margin-top:10px;border-radius:14px;padding:10px">${esc(text)}</textarea><div style="margin-top:10px"><button class="btn block" onclick="closeSheet()">Done</button></div>`);}
}

