    <div class="card tabbody">${rs.tab==='ing'?x.ing.map(([k,q])=>`<div class="ing"><span>${I[k][0].replace(/ \(tins?\)/,'')}${I[k][6]?' <small style="color:var(--muted)">(pantry)</small>':''}</span><span>${fq(k,q*s)}</span></div>`).join('')
